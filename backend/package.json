{
  "name": "kotbis-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API Back-End du projet KotBis",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:inscription": "node --import tsx --test tests/inscription.test.ts",
    "test:connexion-sessions": "node --import tsx --test tests/connexion-sessions.test.ts",
    "test:mot-de-passe-email": "node --import tsx --test tests/motDePasseEmail.test.ts",
    "test:profil": "node --import tsx --test tests/profil.test.ts",
    "test:suppression": "node --import tsx --test tests/suppression.test.ts",
    "test:integration": "node --import tsx --test \"tests/integration/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
